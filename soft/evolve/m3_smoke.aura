;; M3: two-node corridor, shared vs per-node policy, evolution tape.
;; fiber_live only when the shared race joins both fibers.
;; The single-intersection M0 law is not used for the score.
(load "/workspace/aura-evolve/soft/evolve/world.aura")
(load "/workspace/aura-evolve/soft/evolve/strategy.aura")
(load "/workspace/aura-evolve/soft/evolve/hot.aura")
(load "/workspace/aura-evolve/soft/evolve/grid.aura")

(define *fail* 0)
(define *score-split* 0)

(define (expect tag got want)
  (display tag)
  (display "=")
  (display (nstr got))
  (if (= got want)
      (display " OK")
      (begin
        (display " WANT=")
        (display (nstr want))
        (set! *fail* (+ *fail* 1))))
  (newline)
  got)

(define (tag? r want)
  (and (pair? r) (pair? (cdr r)) (equal? (car (cdr r)) want)))

(define (strat-chase age own other)
  (if (> other own) 1 0))

(define (main)
  (display "DIALECT=")
  (display (ev:grid-dialect))
  (newline)
  (let ((seeded (ev:strategy-seed!)))
    (if (not (and (pair? seeded) (equal? (car seeded) #t)))
        (display "EVOLVE_M3_FAIL seed\n")
        (begin
          (let ((sw (ev:apply-body! *chase-body* "grid-swap")))
            (if (not (tag? sw "swap"))
                (begin
                  (display "SWAP_FAIL")
                  (newline)
                  (set! *fail* (+ *fail* 1)))
                (etape! "SWAP" 0 1 0 "grid-swap")))
          (let ((ugly (ev:apply-body!
                       "(lambda (age own other) (cons age own))"
                       "grid-ugly")))
            (if (not (tag? ugly "probe"))
                (begin
                  (display "HEAL_FAIL")
                  (newline)
                  (set! *fail* (+ *fail* 1)))
                (etape! "HEAL" 0 1 0 "probe")))
          (if (not (= (ev:choose 1 0 3) 1))
              (begin
                (display "SLOT_FAIL heal")
                (newline)
                (set! *fail* (+ *fail* 1))))
          (display "POLICY mode=shared\n")
          (let ((pair (ev:race-thunks!
                       (lambda () (ev:grid-run! strat-agg strat-agg "shared-agg" 0))
                       (lambda () (ev:grid-run! strat-calm strat-calm "shared-calm" 0)))))
            (set! *score-agg* (car pair))
            (set! *score-calm* (car (cdr pair))))
          (display "RACE agg=")
          (display (nstr *score-agg*))
          (display " calm=")
          (display (nstr *score-calm*))
          (newline)
          (etape! "RACE" *g-horizon* 1 *score-agg* "shared-agg")
          (etape! "RACE" *g-horizon* 2 *score-calm* "shared-calm")
          (if (>= *score-agg* *score-calm*)
              (begin
                (set! *keep-mid* 1)
                (set! *drop-mid* 2)
                (set! *main-mid* 1)
                (set! *main-name* "shared-agg")
                (set! *main-score* *score-agg*)
                (set! *keep-reason*
                      (if (> *score-agg* *score-calm*)
                          "higher-score-stamp"
                          "tie-keep-agg-stamp"))
                (set! *drop-reason* "lower-score-rollback"))
              (begin
                (set! *keep-mid* 2)
                (set! *drop-mid* 1)
                (set! *main-mid* 2)
                (set! *main-name* "shared-calm")
                (set! *main-score* *score-calm*)
                (set! *keep-reason* "higher-score-stamp")
                (set! *drop-reason* "lower-score-rollback")))
          (display "KEEP mid=")
          (display (number->string *keep-mid*))
          (display " reason=")
          (display *keep-reason*)
          (newline)
          (display "DROP mid=")
          (display (number->string *drop-mid*))
          (display " reason=")
          (display *drop-reason*)
          (newline)
          (etape! "KEEP" *g-horizon* *keep-mid* *main-score* *keep-reason*)
          (etape! "DROP" *g-horizon* *drop-mid*
                  (if (= *drop-mid* 1) *score-agg* *score-calm*)
                  *drop-reason*)
          (set! *score-split* (ev:grid-run! strat-agg strat-chase "per-node" 0))
          (display "POLICY mode=per-node line=host-sequential n0=strat-agg n1=strat-chase score=")
          (display (nstr *score-split*))
          (newline)
          (etape! "RACE" *g-horizon* 3 *score-split* "per-node")
          (if (> *score-split* *main-score*)
              (begin
                (set! *keep-mid* 3)
                (set! *main-mid* 3)
                (set! *main-name* "per-node")
                (set! *keep-reason* "per-node-higher")
                (set! *main-score* *score-split*)
                (display "KEEP mid=3 reason=per-node-higher")
                (newline)
                (etape! "KEEP" *g-horizon* 3 *score-split* "per-node-higher")
                (ev:grid-run! strat-agg strat-chase "per-node" 1))
              (begin
                (display "DROP mid=3 reason=lower-score-rollback")
                (newline)
                (etape! "DROP" *g-horizon* 3 *score-split* "lower-score-rollback")
                (if (= *main-mid* 1)
                    (ev:grid-run! strat-agg strat-agg "shared-agg" 1)
                    (ev:grid-run! strat-calm strat-calm "shared-calm" 1))))
          (ev:grid-audit-nodes!)
          (ev:stamp-world!)
          (display "MAIN slot=")
          (display *main-name*)
          (display " mid=")
          (display (number->string *main-mid*))
          (display " score=")
          (display (nstr *main-score*))
          (newline)
          (expect "NODES" *g-nodes* 2)
          (expect "SCORE_AGG" *score-agg* -1167)
          (expect "SCORE_CALM" *score-calm* -1837)
          (expect "SCORE_SPLIT" *score-split* -1165)
          (expect "MAIN_SCORE" *main-score* -1165)
          (expect "LIVE_SCORE" (g:score) -1165)
          (expect "THRU" *g-thru* 236)
          (expect "TICK" *g-tick* 60)
          (expect "STOP_W" *g-stop-w* 3)
          (expect "KEEP_MID" *keep-mid* 3)
          (expect "DROP_MID" *drop-mid* 2)
          (expect "SCORE_ID" (g:score) (- *g-thru* (+ *g-qpen* *g-spen*)))
          (if (or (< (g:qns 0) 0) (< (g:qew 0) 0) (< (g:qns 1) 0) (< (g:qew 1) 0))
              (begin
                (display "QUEUE_FAIL")
                (newline)
                (set! *fail* (+ *fail* 1))))
          (if (string=? *world-line* "fiber_live")
              (if (not (and (> *race-backend* 0)
                            (> *race-spawned* 0)
                            (= *race-joined* *race-spawned*)))
                  (begin
                    (display "WORLD_FAIL")
                    (newline)
                    (set! *fail* (+ *fail* 1))))
              (if (not (string=? *world-line* "host-sequential"))
                  (begin
                    (display "WORLD_FAIL")
                    (newline)
                    (set! *fail* (+ *fail* 1)))))
          (if (= *fail* 0)
              (display "EVOLVE_M3_OK\n")
              (display "EVOLVE_M3_FAIL\n"))))))

(main)
