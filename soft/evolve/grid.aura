;; M3 grid: two intersections in a corridor (nodes 0 and 1).
;; Each node has its own phase, green age, and NS/EW queues.
;; One shared LCG, one aggregated score: throughput - queue_pen - stop_pen.
;; A shared policy passes the same chooser to both nodes.
;; A per-node policy passes a different chooser to each node.
;; Does not redefine the M0 single-intersection tick. Load world.aura first
;; (for nstr) and, if racing fibers, hot.aura before calling ev:grid-race!.

(define *g-nodes* 2)
(define *g-horizon* 60)
(define *g-seed* 20261005)
(define *g-rng* 20261005)
(define *g-tick* 0)
(define *g-stop-w* 1)
(define *g-serve-cap* 2)
(define *g-thru* 0)
(define *g-stops* 0)
(define *g-spen* 0)
(define *g-qpen* 0)
(define *g-tape* 0)
(define *g-slot* "none")

(define *n0-phase* 0)
(define *n0-age* 0)
(define *n0-qns* 0)
(define *n0-qew* 0)
(define *n1-phase* 0)
(define *n1-age* 0)
(define *n1-qns* 0)
(define *n1-qew* 0)

(define (ev:grid-dialect)
  "city-light-factory-m3")

(define (etape! op tick mid score reason)
  (display "ETAPE op=")
  (display op)
  (display " tick=")
  (display (number->string tick))
  (display " mid=")
  (display (number->string mid))
  (display " score=")
  (display (nstr score))
  (display " reason=")
  (display reason)
  (newline)
  0)

(define (g:phase i)
  (if (= i 0) *n0-phase* *n1-phase*))

(define (g:age i)
  (if (= i 0) *n0-age* *n1-age*))

(define (g:qns i)
  (if (= i 0) *n0-qns* *n1-qns*))

(define (g:qew i)
  (if (= i 0) *n0-qew* *n1-qew*))

(define (g:set-phase! i v)
  (if (= i 0)
      (set! *n0-phase* v)
      (set! *n1-phase* v))
  v)

(define (g:set-age! i v)
  (if (= i 0)
      (set! *n0-age* v)
      (set! *n1-age* v))
  v)

(define (g:set-qns! i v)
  (if (= i 0)
      (set! *n0-qns* v)
      (set! *n1-qns* v))
  v)

(define (g:set-qew! i v)
  (if (= i 0)
      (set! *n0-qew* v)
      (set! *n1-qew* v))
  v)

(define (g:own i)
  (if (= (g:phase i) 0) (g:qns i) (g:qew i)))

(define (g:other i)
  (if (= (g:phase i) 0) (g:qew i) (g:qns i)))

(define (g:score)
  (- *g-thru* (+ *g-qpen* *g-spen*)))

(define (g:rng!)
  (set! *g-rng* (modulo (+ (* *g-rng* 75) 74) 65537))
  *g-rng*)

(define (g:reset! seed)
  (set! *g-seed* seed)
  (set! *g-rng* seed)
  (set! *g-tick* 0)
  (set! *g-stop-w* 1)
  (set! *g-thru* 0)
  (set! *g-stops* 0)
  (set! *g-spen* 0)
  (set! *g-qpen* 0)
  (g:set-phase! 0 0)
  (g:set-phase! 1 0)
  (g:set-age! 0 0)
  (g:set-age! 1 0)
  (g:set-qns! 0 0)
  (g:set-qns! 1 0)
  (g:set-qew! 0 0)
  (g:set-qew! 1 0)
  0)

(define (g:arrive! i)
  (let ((ns (modulo (g:rng!) 3))
        (ew (modulo (g:rng!) 3))
        (ph (g:phase i)))
    (if (and (> ns 0) (= ph 1))
        (begin
          (set! *g-stops* (+ *g-stops* ns))
          (set! *g-spen* (+ *g-spen* (* *g-stop-w* ns)))))
    (if (and (> ew 0) (= ph 0))
        (begin
          (set! *g-stops* (+ *g-stops* ew))
          (set! *g-spen* (+ *g-spen* (* *g-stop-w* ew)))))
    (g:set-qns! i (+ (g:qns i) ns))
    (g:set-qew! i (+ (g:qew i) ew))
    0))

(define (g:decide! i chooser)
  (if (= (chooser (g:age i) (g:own i) (g:other i)) 1)
      (begin
        (g:set-phase! i (if (= (g:phase i) 0) 1 0))
        (g:set-age! i 0)))
  0)

(define (g:serve! i)
  (let ((n 0))
    (if (= (g:phase i) 0)
        (begin
          (set! n (if (< (g:qns i) *g-serve-cap*) (g:qns i) *g-serve-cap*))
          (g:set-qns! i (- (g:qns i) n)))
        (begin
          (set! n (if (< (g:qew i) *g-serve-cap*) (g:qew i) *g-serve-cap*))
          (g:set-qew! i (- (g:qew i) n))))
    (set! *g-thru* (+ *g-thru* n))
    n))

(define (g:tape-line!)
  (if (and (= *g-tape* 1) (= (modulo *g-tick* 10) 0))
      (begin
        (display "TAPE tick=")
        (display (number->string *g-tick*))
        (display " n0p=")
        (display (number->string (g:phase 0)))
        (display " n0a=")
        (display (number->string (g:age 0)))
        (display " n0ns=")
        (display (number->string (g:qns 0)))
        (display " n0ew=")
        (display (number->string (g:qew 0)))
        (display " n1p=")
        (display (number->string (g:phase 1)))
        (display " n1a=")
        (display (number->string (g:age 1)))
        (display " n1ns=")
        (display (number->string (g:qns 1)))
        (display " n1ew=")
        (display (number->string (g:qew 1)))
        (display " thru=")
        (display (number->string *g-thru*))
        (display " slot=")
        (display *g-slot*)
        (newline)))
  0)

;; Simultaneous tick: both nodes arrive, then both choose, then both serve.
;; Score adds both nodes. Tick 24 raises stop weight once for the corridor.
(define (g:tick! c0 c1)
  (g:arrive! 0)
  (g:arrive! 1)
  (g:decide! 0 c0)
  (g:decide! 1 c1)
  (g:serve! 0)
  (g:serve! 1)
  (set! *g-qpen* (+ *g-qpen* (g:qns 0) (g:qew 0) (g:qns 1) (g:qew 1)))
  (g:set-age! 0 (+ (g:age 0) 1))
  (g:set-age! 1 (+ (g:age 1) 1))
  (set! *g-tick* (+ *g-tick* 1))
  (if (= *g-tick* 24)
      (begin
        (set! *g-stop-w* 3)
        (display "MUTATE tick=24 stop-w=3 slot=")
        (display *g-slot*)
        (newline)
        (etape! "MUTATE" 24 0 (g:score) "stop-w=3")))
  (g:tape-line!)
  *g-tick*)

;; c0 chooses for node 0, c1 for node 1. Same procedure = shared policy.
(define (ev:grid-run! c0 c1 tag tape)
  (set! *g-tape* tape)
  (set! *g-slot* tag)
  (g:reset! *g-seed*)
  (let loop ((i 0))
    (if (< i *g-horizon*)
        (begin
          (g:tick! c0 c1)
          (loop (+ i 1)))))
  (g:score))

(define (ev:grid-audit-nodes!)
  (display "GRID nodes=")
  (display (number->string *g-nodes*))
  (display " shape=corridor")
  (display " q0ns=")
  (display (number->string (g:qns 0)))
  (display " q0ew=")
  (display (number->string (g:qew 0)))
  (display " q1ns=")
  (display (number->string (g:qns 1)))
  (display " q1ew=")
  (display (number->string (g:qew 1)))
  (newline)
  (display "GRID thru=")
  (display (number->string *g-thru*))
  (display " qpen=")
  (display (number->string *g-qpen*))
  (display " spen=")
  (display (number->string *g-spen*))
  (display " score=")
  (display (nstr (g:score)))
  (newline)
  0)
