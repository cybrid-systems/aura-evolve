;; aura-evolve M0 — one intersection, Soft FlatAST world.
;; NS / EW is a city crossing or two factory lines sharing one green.
;; phase 0 = NS green, phase 1 = EW green. No C viewport.

(define *horizon* 60)
(define *seed* 20261005)
(define *rng* 20261005)
(define *phase* 0)
(define *green-age* 0)
(define *q-ns* 0)
(define *q-ew* 0)
(define *throughput* 0)
(define *stops* 0)
(define *stop-pen* 0)
(define *queue-pen* 0)
(define *tick* 0)
(define *stop-w* 1)
(define *serve-cap* 2)
(define *tape* 0)
(define *slot-tag* "none")

(define (ev:dialect)
  "city-light-factory-m0")

(define (nstr n)
  (if (< n 0)
      (string-append "-" (number->string (- 0 n)))
      (number->string n)))

(define (ev:rng!)
  (set! *rng* (modulo (+ (* *rng* 75) 74) 65537))
  *rng*)

(define (ev:reset! seed)
  (set! *seed* seed)
  (set! *rng* seed)
  (set! *phase* 0)
  (set! *green-age* 0)
  (set! *q-ns* 0)
  (set! *q-ew* 0)
  (set! *throughput* 0)
  (set! *stops* 0)
  (set! *stop-pen* 0)
  (set! *queue-pen* 0)
  (set! *tick* 0)
  (set! *stop-w* 1)
  0)

(define (ev:score)
  (- *throughput* (+ *queue-pen* *stop-pen*)))

(define (ev:own)
  (if (= *phase* 0) *q-ns* *q-ew*))

(define (ev:other)
  (if (= *phase* 0) *q-ew* *q-ns*))

(define (ev:arrive!)
  (let ((ns (modulo (ev:rng!) 3))
        (ew (modulo (ev:rng!) 3)))
    (if (and (> ns 0) (= *phase* 1))
        (begin
          (set! *stops* (+ *stops* ns))
          (set! *stop-pen* (+ *stop-pen* (* *stop-w* ns)))))
    (if (and (> ew 0) (= *phase* 0))
        (begin
          (set! *stops* (+ *stops* ew))
          (set! *stop-pen* (+ *stop-pen* (* *stop-w* ew)))))
    (set! *q-ns* (+ *q-ns* ns))
    (set! *q-ew* (+ *q-ew* ew))
    0))

(define (ev:serve!)
  (let ((n 0))
    (if (= *phase* 0)
        (begin
          (set! n (if (< *q-ns* *serve-cap*) *q-ns* *serve-cap*))
          (set! *q-ns* (- *q-ns* n)))
        (begin
          (set! n (if (< *q-ew* *serve-cap*) *q-ew* *serve-cap*))
          (set! *q-ew* (- *q-ew* n))))
    (set! *throughput* (+ *throughput* n))
    n))

(define (ev:tape!)
  (if (and (= *tape* 1) (= (modulo *tick* 10) 0))
      (begin
        (display "TAPE tick=")
        (display (number->string *tick*))
        (display " phase=")
        (display (number->string *phase*))
        (display " age=")
        (display (number->string *green-age*))
        (display " qns=")
        (display (number->string *q-ns*))
        (display " qew=")
        (display (number->string *q-ew*))
        (display " thru=")
        (display (number->string *throughput*))
        (display " slot=")
        (display *slot-tag*)
        (newline)))
  0)

;; chooser: (lambda (age own other) ...) => 1 switch, 0 hold.
(define (ev:tick! chooser tag)
  (set! *slot-tag* tag)
  (ev:arrive!)
  (if (= (chooser *green-age* (ev:own) (ev:other)) 1)
      (begin
        (set! *phase* (if (= *phase* 0) 1 0))
        (set! *green-age* 0)))
  (ev:serve!)
  (set! *queue-pen* (+ *queue-pen* *q-ns* *q-ew*))
  (set! *green-age* (+ *green-age* 1))
  (set! *tick* (+ *tick* 1))
  (if (= *tick* 24)
      (begin
        (set! *stop-w* 3)
        (display "MUTATE tick=24 stop-w=3 slot=")
        (display tag)
        (newline)))
  (ev:tape!)
  *tick*)
