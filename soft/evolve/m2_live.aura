;; One host-written lambda. Any honest gate result is success.
;; Missing file or a Soft error is not. HTTP stays in the host script.
(load "/workspace/aura-evolve/soft/evolve/world.aura")
(load "/workspace/aura-evolve/soft/evolve/strategy.aura")
(load "/workspace/aura-evolve/soft/evolve/propose.aura")

(define (live-tag? s)
  (or (string=? s "propose_keep")
      (or (string=? s "propose_drop")
          (or (string=? s "propose_heal")
              (string=? s "propose_reject")))))

(define (main)
  (let ((seeded (ev:strategy-seed!)))
    (if (not (and (pair? seeded) (equal? (car seeded) #t)))
        (display "EVOLVE_M2_PROPOSE_LIVE_FAIL seed\n")
        (let ((path (getenv "EVOLVE_PROPOSE_FILE")))
          (if (not (and (string? path) (> (string-length path) 0)))
              (display "EVOLVE_M2_PROPOSE_LIVE_FAIL path\n")
              (let ((r (ev:propose-file! path)))
                (ev:stamp-world!)
                (if (and (pair? r) (pair? (cdr r)) (live-tag? (car (cdr r))))
                    (display "EVOLVE_M2_PROPOSE_LIVE_OK\n")
                    (display "EVOLVE_M2_PROPOSE_LIVE_FAIL\n"))))))))

(main)
