;; Sustained PK on the two-node corridor.
;; Each round: gate a lambda, race it as a shared policy against the main.
;; KEEP only on a strictly higher aggregate score. Tie is DROP + heal.
;; fiber_live only when every race's joins landed (same counters as M1/M2).
;; Fixture pins (EVOLVE_PROPOSE=0, horizon 24) are the offline contract.
;; Live MiniMax rounds are not pinned.
(load "/workspace/aura-evolve/soft/evolve/world.aura")
(load "/workspace/aura-evolve/soft/evolve/strategy.aura")
(load "/workspace/aura-evolve/soft/evolve/propose.aura")
(load "/workspace/aura-evolve/soft/evolve/grid.aura")

(define *fail* 0)
(define *pk-rounds-done* 0)

(define (ev:env-int name fallback)
  (let ((raw (getenv name)))
    (if (and (string? raw) (> (string-length raw) 0))
        (let ((n (string->number raw)))
          (if (number? n) n fallback))
        fallback)))

(define (ev:pin?)
  (let ((p (getenv "EVOLVE_PROPOSE")))
    (and (string? p)
         (string=? p "0")
         (= *g-horizon* 24)
         (= (ev:env-int "EVOLVE_BURN_ROUNDS" 4) 4))))

(define (want name got exp)
  (display "PIN ")
  (display name)
  (display "=")
  (display (nstr got))
  (if (= got exp)
      (display " OK")
      (begin
        (display " WANT=")
        (display (nstr exp))
        (set! *fail* (+ *fail* 1))))
  (newline)
  0)

(define (want-s name got exp)
  (display "PIN ")
  (display name)
  (display "=")
  (display got)
  (if (string=? got exp)
      (display " OK")
      (begin
        (display " WANT=")
        (display exp)
        (set! *fail* (+ *fail* 1))))
  (newline)
  0)

(define (ev:pin-round! i base trial tag)
  (if (not (ev:pin?))
      0
      (cond
        ((= i 1)
         (begin (want "R1_BASE" base -276)
                (want "R1_TRIAL" trial -237)
                (want-s "R1_TAG" tag "propose_keep")))
        ((= i 2)
         (begin (want "R2_BASE" base -237)
                (want "R2_TRIAL" trial -291)
                (want-s "R2_TAG" tag "propose_drop")))
        ((= i 3)
         (begin (want "R3_BASE" base -237)
                (want "R3_TRIAL" trial -731)
                (want-s "R3_TAG" tag "propose_drop")))
        ((= i 4)
         (begin (want "R4_BASE" base -237)
                (want "R4_TRIAL" trial -237)
                (want-s "R4_TAG" tag "propose_drop")))
        (#t 0))))

(define (tag-of r)
  (if (and (pair? r) (pair? (cdr r)) (string? (car (cdr r))))
      (car (cdr r))
      ""))

(define (ev:pk-line! i tag base trial)
  (display "PK round=")
  (display (number->string i))
  (display " tag=")
  (display tag)
  (display " base=")
  (display (nstr base))
  (display " trial=")
  (display (nstr trial))
  (display " main=")
  (display (nstr *main-score*))
  (newline)
  (set! *pk-rounds-done* (+ *pk-rounds-done* 1))
  0)

(define (ev:known-tag? tag)
  (or (string=? tag "propose_keep")
      (or (string=? tag "propose_drop")
          (or (string=? tag "propose_heal")
              (string=? tag "propose_reject")))))

(define (ev:pk-score! clean i)
  (let ((pair (ev:race-thunks!
               (lambda () (ev:grid-run! ev:shadow ev:shadow "strat-main" 0))
               (lambda () (ev:grid-run! ev:choose ev:choose "strat-trial" 0)))))
    (let ((base (car pair))
          (trial (car (cdr pair))))
      (set! *base-last* base)
      (set! *trial-last* trial)
      (display "RACE base=")
      (display (nstr base))
      (display " trial=")
      (display (nstr trial))
      (newline)
      (etape! "RACE" *g-horizon* i trial "pk")
      (if (> trial base)
          (begin
            (set! *main-body* clean)
            (set! *main-score* trial)
            (set! *main-name* "ev:choose")
            (set! *keep-reason* "higher-score-stamp")
            (display "KEEP reason=higher-score-stamp")
            (newline)
            (etape! "KEEP" *g-horizon* i trial "higher-score-stamp")
            (ev:grid-run! ev:choose ev:choose "pk-keep" 1)
            (ev:pk-line! i "propose_keep" base trial)
            (ev:pin-round! i base trial "propose_keep"))
          (begin
            (hot-strategy:heal!)
            (display "HEAL name=ev:choose reason=score")
            (newline)
            (display "DROP reason=lower-score-rollback")
            (newline)
            (etape! "HEAL" *g-horizon* i base "score")
            (etape! "DROP" *g-horizon* i trial "lower-score-rollback")
            (ev:pk-line! i "propose_drop" base trial)
            (ev:pin-round! i base trial "propose_drop"))))))

(define (ev:pk-round! i dir)
  (display "PK_ROUND=")
  (display (number->string i))
  (newline)
  (ev:sync-main!)
  (let ((body (try (read-file (string-append dir "/" (number->string i) ".lambda"))
                   (catch (e) #f))))
    (if (not (string? body))
        (begin
          (display "GATE reject reason=read")
          (newline)
          (etape! "DROP" 0 i 0 "read")
          (ev:pk-line! i "propose_reject" 0 0)
          (ev:pin-round! i 0 0 "propose_reject"))
        (let ((clean (string-trim body)))
          (let ((r (ev:apply-body! clean "pk")))
            (let ((tg (tag-of r)))
              (cond
                ((string=? tg "swap")
                 (etape! "SWAP" *g-tick* i 0 "pk")
                 (ev:pk-score! clean i))
                ((string=? tg "probe")
                 (etape! "HEAL" *g-tick* i 0 "probe")
                 (ev:pk-line! i "propose_heal" 0 0)
                 (ev:pin-round! i 0 0 "propose_heal"))
                (#t
                 (etape! "DROP" *g-tick* i 0 "gate")
                 (ev:pk-line! i "propose_reject" 0 0)
                 (ev:pin-round! i 0 0 "propose_reject")))))))))

(define (ev:pk!)
  (let ((dir (getenv "EVOLVE_ROUND_DIR"))
        (rounds (ev:env-int "EVOLVE_BURN_ROUNDS" 4))
        (hz (ev:env-int "EVOLVE_HORIZON" 24)))
    (set! *g-horizon* hz)
    (display "PK rounds=")
    (display (number->string rounds))
    (display " horizon=")
    (display (number->string hz))
    (display " nodes=2")
    (newline)
    (if (not (and (string? dir) (> (string-length dir) 0)))
        (display "EVOLVE_PK_FAIL dir\n")
        (let ((seeded (ev:strategy-seed!)))
          (if (not (and (pair? seeded) (equal? (car seeded) #t)))
              (display "EVOLVE_PK_FAIL seed\n")
              (begin
                (set! *main-score* (ev:grid-run! ev:shadow ev:shadow "baseline" 0))
                (display "BASELINE policy=strat-agg score=")
                (display (nstr *main-score*))
                (newline)
                (etape! "RACE" *g-horizon* 0 *main-score* "baseline-agg")
                (if (ev:pin?)
                    (want "BASELINE" *main-score* -276))
                (let loop ((i 1))
                  (if (> i rounds)
                      0
                      (begin
                        (ev:pk-round! i dir)
                        (loop (+ i 1)))))
                (ev:stamp-world!)
                (display "MAIN score=")
                (display (nstr *main-score*))
                (newline)
                (if (ev:pin?)
                    (want "MAIN" *main-score* -237))
                (if (not (= *pk-rounds-done* rounds))
                    (begin
                      (display "ROUND_FAIL")
                      (newline)
                      (set! *fail* (+ *fail* 1))))
                (if (string=? *world-line* "fiber_live")
                    (if (not (and (> *race-backend* 0)
                                  (> *race-spawned* 0)
                                  (= *race-joined* *race-spawned*)))
                        (begin
                          (display "WORLD_FAIL")
                          (newline)
                          (set! *fail* (+ *fail* 1))))
                    (if (not (string=? *world-line* "host-sequential"))
                        (begin
                          (display "WORLD_FAIL")
                          (newline)
                          (set! *fail* (+ *fail* 1)))))
                (if (= *fail* 0)
                    (display "EVOLVE_PK_OK\n")
                    (display "EVOLVE_PK_FAIL\n"))))))))

(ev:pk!)
